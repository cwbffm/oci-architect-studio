# Load into the server process; never commit a filled file. No default secret.
STUDIO_AUTH_MODE=token
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
STUDIO_API_TOKEN=
STUDIO_ALLOWED_ORIGINS=https://cwbffm.github.io,http://localhost:8080
STUDIO_REGIONS=sa-saopaulo-1
# JSON object: only these compartments can be targeted (not tenancy-wide).
STUDIO_COMPARTMENTS={"ocid1.compartment.oc1..REPLACE_WITH_REAL_OCID":"Development"}
STUDIO_DATABASE_PATH=./data/studio.sqlite3
STUDIO_OCI_AUTH=instance_principal
# Pick a version reported as supported by Resource Manager in your region.
STUDIO_TERRAFORM_VERSION=1.5.x
# Optional multi-user OIDC, use instead of a shared operator token:
# STUDIO_AUTH_MODE=oidc
# STUDIO_OIDC_ISSUER=https://YOUR_IDENTITY_DOMAIN.identity.oraclecloud.com
# STUDIO_OIDC_JWKS_URL=https://YOUR_IDENTITY_DOMAIN.identity.oraclecloud.com/admin/v1/SigningCert/jwk
# STUDIO_OIDC_AUDIENCE=YOUR_API_AUDIENCE
# STUDIO_OIDC_CLIENT_ID=YOUR_PUBLIC_BROWSER_CLIENT_ID
# STUDIO_OIDC_SCOPES=openid profile YOUR_REGISTERED_API_SCOPE
# STUDIO_ALLOWED_SUBJECTS=USER_SUBJECT_1,USER_SUBJECT_2
# STUDIO_ALLOWED_GROUPS=YOUR_AUTHORIZED_GROUP
# Local developer profile only (uses local ~/.oci/config; never uploaded):
# STUDIO_OCI_AUTH=config
# STUDIO_OCI_CONFIG_PROFILE=DEFAULT
